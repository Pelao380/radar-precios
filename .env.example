# Copiar a .env. Con docker compose, DATABASE_URL/REDIS_URL/SMTP se sobrescriben solos.

# --- Infra (local o cloud: Neon / Upstash) ---
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
REDIS_URL=redis://localhost:6379/0

# --- Fuentes ---
SOURCE_MODE=simulated          # simulated | vtex
SCRAPE_EVERY_HOURS=6
HTTP_RATE_PER_MINUTE=20
HTTP_CACHE_TTL=1800
# VTEX_BASE_URL_UNIMARC=https://...   (solo con SOURCE_MODE=vtex y endpoint verificado)

# --- IA (opcionales: sin ellas todo funciona con reglas + embeddings locales) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
EMBEDDINGS_PROVIDER=hashing    # hashing | voyage
VOYAGE_API_KEY=

# --- Alertas por correo ---
ALERT_MIN_DROP_PCT=10
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=radar@localhost
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
